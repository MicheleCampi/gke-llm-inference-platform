# Versions the validation renders and checks against. ci/validate.sh fails if
# a chart version or OPERATOR_TAG differs from what the ArgoCD Applications
# deploy, if a chart's SHA-256 differs, or if OPERATOR_TAG does not resolve to
# OPERATOR_COMMIT.
ARGOCD_CHART_VERSION=9.5.21
ARGOCD_CHART_SHA256=5e440d83c763360e16cd93b48f41450cc0d688ec83ee444840faa271ac536443
ESO_CHART_VERSION=2.6.0
ESO_CHART_SHA256=f3659c0085a41e1be5c016cf186b80aac262ef249a91b1b770b941f18296ef3f
OPERATOR_TAG=v0.2.1
OPERATOR_COMMIT=bc101119f4e26ecb51dd550a38a594036cda8f0f
# trivy misconfiguration checks: the OCI bundle at a fixed digest instead of
# the moving :2 tag, so the same commit gets the same verdict on any day.
TRIVY_CHECKS=mirror.gcr.io/aquasec/trivy-checks@sha256:1583562f8b90ed2a071b99f0e5ffff6b57e4ceb6ca3e4796577b4e6a339eb74c
