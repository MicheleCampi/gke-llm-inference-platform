# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!terraform.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# The lock file IS committed (reproducibility): do not ignore it.
!.terraform.lock.hcl

# Saved plans (binary, ephemeral, may contain sensitive values)
*.tfplan
tfplan

# CI tools installed by ci/install-tools.sh
.ci-bin/

# Credentials written by google-github-actions/auth (its README asks for this)
gha-creds-*.json
